@model ClassicCars.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/register.css" />

<div class="container">
    <div class="left">
        <div class="avatar">
            <span class="icon">👤</span>
        </div>
        <h1>My Profile</h1>
        <p>Classic cars member</p>
    </div>

    <div class="right">
        <h2 class="title">Register</h2>

        <form asp-action="Register" asp-controller="Account" method="post">

            <input asp-for="UserName" placeholder="Username" class="form-input" />
            <span asp-validation-for="UserName"></span>

            <input asp-for="Email" placeholder="Email" class="form-input" />
            <span asp-validation-for="Email"></span>

            <input asp-for="FirstName" placeholder="First Name" class="form-input" />
            <span asp-validation-for="FirstName"></span>

            <input asp-for="LastName" placeholder="Last Name" class="form-input" />
            <span asp-validation-for="LastName"></span>

            <input asp-for="Password" type="password" placeholder="Password" class="form-input" />
            <span asp-validation-for="Password"></span>

            <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" class="form-input" />
            <span asp-validation-for="ConfirmPassword"></span>

            <button type="submit" class="submit-btn">
                Register
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
