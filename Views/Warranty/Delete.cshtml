@model ClassicCars.Dtos.WarrantyDto

@{
    ViewData["Title"] = "Delete Warranty";
}

<div class="card box-shadow mt-4">
    <div class="card-body">
        <h3 class="card-title mb-3">@ViewData["Title"]</h3>

        <p class="lead">Are you sure you want to delete this warranty?</p>

        <div class="mb-3">
            <strong>Provider:</strong> @Model.Provider
        </div>
        <div class="mb-3">
            <strong>Coverage Amount:</strong> @Model.CoverageAmount
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" name="carId" value="@Model.CarId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-controller="Cars" asp-action="Details" asp-route-id="@Model.CarId" class="btn btn-secondary ms-2">Cancel</a>
            @Html.AntiForgeryToken()
        </form>
    </div>
</div>
