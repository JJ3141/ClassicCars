<!DOCTYPE html>
<html lang="en">
<body>

    @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Administrator"))
    {
        <div style="background:#f8f9fa;border-bottom:1px solid #e5e5e5;padding:8px 0;margin-bottom:12px;">
            <div class="container">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">Admin Dashboard</a>
                &nbsp;|&nbsp;
                <a asp-area="Admin" asp-controller="Users" asp-action="Index">Manage Users / Roles</a>
            </div>
        </div>
    }

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @*<footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - ClassicCars - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>*@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
