@model ClassicCars.ViewModels.ProfileViewModel

<link rel="stylesheet" href="~/css/profile.css" />
<div class="container">

    <aside class="profile">
        <div class="avatar"><span>👤</span></div>
        <h2>@Model.FirstName @Model.LastName</h2>
        <p class="member">Classic cars member</p>
        <hr>
    </aside>

    <main class="content">
        @await Html.PartialAsync("_NavBar")


        <section class="cars">
            <div class="cars-header">
                <h2>My cars</h2>
                <button type="button" class="add-car" onclick="toggleAddCarForm()">Add new car</button>
            </div>

            <div id="addCarModal" class="modal">
                <div class="modal-content">
                    <div class="modal-left">
                        <form asp-controller="Profile" asp-action="Create" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="All" class="text-danger"></div>

                            <input asp-for="NewCar.Brand" placeholder="Brand" />
                            <span asp-validation-for="NewCar.Brand" class="text-danger"></span>

                            <input asp-for="NewCar.Model" placeholder="Model" />
                            <span asp-validation-for="NewCar.Model" class="text-danger"></span>

                            <input asp-for="NewCar.Year" placeholder="Year (1900-2100)" min="1900" max="2100" />
                            <span asp-validation-for="NewCar.Year" class="text-danger"></span>

                            <input asp-for="NewCar.EngineType" placeholder="Engine Type" />
                            <span asp-validation-for="NewCar.EngineType" class="text-danger"></span>

                            <input asp-for="NewCar.Horsepower" placeholder="Horsepower" />
                            <span asp-validation-for="NewCar.Horsepower" class="text-danger"></span>

                            <input asp-for="NewCar.Condition" placeholder="Condition" />
                            <span asp-validation-for="NewCar.Condition" class="text-danger"></span>

                            <input asp-for="NewCar.Price" step="0.01" placeholder="Price" />
                            <span asp-validation-for="NewCar.Price" class="text-danger"></span>

                            <input asp-for="NewCar.Image" type="file" />
                            <span asp-validation-for="NewCar.Image" class="text-danger"></span>

                            <textarea asp-for="NewCar.Description" placeholder="Description"></textarea>
                            <span asp-validation-for="NewCar.Description" class="text-danger"></span>

                            <input asp-for="NewCar.Transmission" placeholder="Transmission" />
                            <span asp-validation-for="NewCar.Transmission" class="text-danger"></span>

                            <button type="submit" class="submit-btn">ADD CAR</button>
                            <button type="button" class="cancel-btn" onclick="cancelAddCar()">Cancel</button>
                        </form>
                    </div>
                    <div class="modal-right">
                        <div class="car-preview">🚗</div>
                        <span class="preview-text">Classic cars</span>
                    </div>
                </div>
            </div>

            <div id="editCarModal" class="modal">
                <div class="modal-content">
                    <div class="modal-left">
                        <form asp-controller="Profile" asp-action="Edit" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="All" class="text-danger"></div>

                            <input asp-for="EditCar.Id" id="editId" type="hidden" />

                            <input asp-for="EditCar.Brand" id="editBrand" placeholder="Brand" />
                            <span asp-validation-for="EditCar.Brand" class="text-danger"></span>

                            <input asp-for="EditCar.Model" id="editModel" placeholder="Model" />
                            <span asp-validation-for="EditCar.Model" class="text-danger"></span>

                            <input asp-for="EditCar.Year" id="editYear" min="1900" max="2100" />
                            <span asp-validation-for="EditCar.Year" class="text-danger"></span>

                            <input asp-for="EditCar.EngineType" id="editEngineType" placeholder="Engine Type" />
                            <span asp-validation-for="EditCar.EngineType" class="text-danger"></span>

                            <input asp-for="EditCar.Horsepower" id="editHorsepower" placeholder="Horsepower" />
                            <span asp-validation-for="EditCar.Horsepower" class="text-danger"></span>

                            <input asp-for="EditCar.Condition" id="editCondition" placeholder="Condition" />
                            <span asp-validation-for="EditCar.Condition" class="text-danger"></span>

                            <input asp-for="EditCar.Price" id="editPrice" step="0.01" />
                            <span asp-validation-for="EditCar.Price" class="text-danger"></span>

                            <input asp-for="EditCar.Image" type="file" />
                            <span asp-validation-for="EditCar.Image" class="text-danger"></span>

                            <textarea asp-for="EditCar.Description" id="editDescription"></textarea>
                            <span asp-validation-for="EditCar.Description" class="text-danger"></span>

                            <input asp-for="EditCar.Transmission" id="editTransmission" placeholder="Transmission" />
                            <span asp-validation-for="EditCar.Transmission" class="text-danger"></span>

                            <button type="submit" class="submit-btn">SAVE CHANGES</button>
                            <button type="button" class="cancel-btn" onclick="closeEditModal()">Cancel</button>
                        </form>
                    </div>
                    <div class="modal-right">
                        <div class="car-preview">🚗</div>
                        <span class="preview-text">Edit car</span>
                    </div>
                </div>
            </div>

            @{ int i = 0; }
            <div class="car-list">
                @foreach (var car in Model.Cars)
                {
                    var extraClass = i >= 3 ? "extra" : "";
                    var base64 = Convert.ToBase64String(car.ImageData);
                    var imgSrc = $"data:image/jpeg;base64,{base64}";

                    <div class="car-card-link @extraClass">
                        <a asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id" style="text-decoration:none; color:inherit;">
                            <div class="car-card">
                                <div class="car-image" style="background-image:url('@imgSrc')"></div>
                                <p><strong>@car.Model</strong> <span class="price">@car.Price</span></p>
                                <p class="desc">@car.Description</p>
                            </div>
                        </a>

                        <div class="car-actions">
                            <button type="button"
                                    class="edit-btn"
                                    data-id="@car.Id"
                                    data-brand="@car.Brand"
                                    data-model="@car.Model"
                                    data-year="@car.Year"
                                    data-enginetype="@car.EngineType"
                                    data-horsepower="@car.Horsepower"
                                    data-condition="@car.Condition"
                                    data-price="@car.Price"
                                    data-description="@car.Description"
                                    data-transmission="@car.Transmission"
                                    onclick="openEditModalFromButton(this)">
                                Edit
                            </button>

                            <form asp-controller="Profile" asp-action="Delete" method="post" style="display:inline;"
                                  onsubmit="return confirm('Are you sure you want to delete this car?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@car.Id" />
                                <button type="submit" class="edit-btn">Delete</button>
                            </form>
                        </div>
                    </div>

                    i++;
                }
            </div>

            <button class="more-btn" onclick="toggleCars()">More</button>
        </section>

        <section class="account">
            <h3>Account Details</h3>
            <div class="detail"><span class="label">Username</span><span class="value">@Model.Username</span></div>
            <div class="detail"><span class="label">Email</span><span class="value">@Model.Email</span></div>
            <div class="detail"><span class="label">First Name</span><span class="value">@Model.FirstName</span></div>
            <div class="detail"><span class="label">Last Name</span><span class="value">@Model.LastName</span></div>
        </section>
        @await Html.PartialAsync("_Footer")
    </main>
</div>

<script>let expanded = false;

    function toggleCars() {
        const extraCars = document.querySelectorAll('.car-card-link.extra');
        const btn = document.querySelector('.more-btn');
        extraCars.forEach(car => car.style.display = expanded ? 'none' : 'block');
        btn.textContent = expanded ? 'More' : 'Less';
        expanded = !expanded;
    }

    function toggleAddCarForm() {
        const modal = document.getElementById("addCarModal");
        modal.style.display = modal.style.display === "flex" ? "none" : "flex";
    }

    function cancelAddCar() {
        const modal = document.getElementById("addCarModal");
        const form = modal.querySelector("form");
        form.reset();
        modal.style.display = "none";
    }

    function openEditModal(id, brand, model, year, engineType, horsepower, condition, price, description, transmission) {
        document.getElementById("editId").value = id;
        document.getElementById("editBrand").value = brand;
        document.getElementById("editModel").value = model;
        document.getElementById("editYear").value = year;
        document.getElementById("editEngineType").value = engineType;
        document.getElementById("editHorsepower").value = horsepower;
        document.getElementById("editCondition").value = condition;
        document.getElementById("editPrice").value = price;
        document.getElementById("editDescription").value = description;
        document.getElementById("editTransmission").value = transmission;
        document.getElementById("editCarModal").style.display = "flex";
    }

    function openEditModalFromButton(btn) {
        const dataset = btn.dataset;
        document.getElementById("editId").value = dataset.id || '';
        document.getElementById("editBrand").value = dataset.brand || '';
        document.getElementById("editModel").value = dataset.model || '';
        document.getElementById("editYear").value = dataset.year || '';
        document.getElementById("editEngineType").value = dataset.enginetype || '';
        document.getElementById("editHorsepower").value = dataset.horsepower || '';
        document.getElementById("editCondition").value = dataset.condition || '';
        document.getElementById("editPrice").value = dataset.price || '';
        document.getElementById("editDescription").value = dataset.description || '';
        document.getElementById("editTransmission").value = dataset.transmission || '';
        document.getElementById("editCarModal").style.display = 'flex';
    }

    function closeEditModal() {
        const modal = document.getElementById("editCarModal");
        modal.style.display = "none";
    }</script>
@if (Model.EditCar != null)
{
    <script>
        // populate and open edit modal when server returned validation errors
        (function(){
            const e = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EditCar));
            document.getElementById("editId").value = e.Id;
            document.getElementById("editBrand").value = e.Brand || '';
            document.getElementById("editModel").value = e.Model || '';
            document.getElementById("editYear").value = e.Year || '';
            document.getElementById("editEngineType").value = e.EngineType || '';
            document.getElementById("editHorsepower").value = e.Horsepower || '';
            document.getElementById("editCondition").value = e.Condition || '';
            document.getElementById("editPrice").value = e.Price || '';
            document.getElementById("editDescription").value = e.Description || '';
            document.getElementById("editTransmission").value = e.Transmission || '';
            document.getElementById("editCarModal").style.display = 'flex';
        })();
    </script>
}
    @section Scripts{
        <partial name="_ValidationScriptsPartial" />
    }
