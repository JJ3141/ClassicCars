@model ClassicCars.Areas.Admin.ViewModels.EditUserRolesViewModel

@{
    ViewData["Title"] = "Edit Roles";
}

<h2>Edit Roles for @Model.UserName</h2>

<form method="post" asp-area="Admin" asp-controller="Users" asp-action="EditRoles">
    <input type="hidden" asp-for="UserId" />
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" value="@Model.FirstName @Model.LastName" readonly />
    </div>

    <div class="mb-3">
    <label class="form-label">Role</label>
    <select class="form-select" asp-for="SelectedRole" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.AllRoles))">
        <option value="">-- No role --</option>
    </select>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>